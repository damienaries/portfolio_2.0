# Google Apps Script web app that receives the contact form.
# Setup: docs/contact-apps-script.md
# NEXT_PUBLIC_ is inlined at build time, so changing it needs a redeploy.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Used at build time by src/lib/projects.ts to read each repo's last-pushed date
# and public/private status. Optional — without it, dates fall back to
# publishedAt and no Source links are shown.
GITHUB_TOKEN=
